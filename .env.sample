# =============================================================================
# n8n Enterprise Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your deployment
# Memory requirements: This configuration is optimized for a 32 GB RAM server

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# PostgreSQL Performance Tuning (configured via docker-compose.yml command)
# These settings are applied directly in the compose file for a 32 GB server:
# - shared_buffers=8GB (25% of RAM for buffer cache)
# - effective_cache_size=24GB (75% of RAM for query planner)
# - work_mem=256MB (memory per sort/hash operation)
# - maintenance_work_mem=1GB (vacuum and index operations)
# - random_page_cost=1.1 (SSD optimization)
# - checkpoint_completion_target=0.9 (smoother checkpoints)
# - wal_buffers=64MB (write-ahead log performance)

# =============================================================================
# n8n Core Configuration
# =============================================================================
N8N_ENCRYPTION_KEY=change_me
N8N_USER_MANAGEMENT_JWT_SECRET=change_me
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# n8n Version (optional - defaults to latest)
# N8N_VERSION=1.70.0

# =============================================================================
# Host and Domain Configuration
# =============================================================================
SUBDOMAIN=n8n
DOMAIN_NAME=example.com
GENERIC_TIMEZONE=UTC

# =============================================================================
# Database Connection Pool (configured in docker-compose.yml)
# =============================================================================
# DB_POSTGRESDB_POOL_SIZE=10 (increased from default 2)
# DB_POSTGRESDB_CONNECTION_TIMEOUT=30000 (30 seconds)
# DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=60000 (60 seconds)

# =============================================================================
# Execution Data Pruning (configured in docker-compose.yml)
# =============================================================================
# EXECUTIONS_DATA_PRUNE=true (automatic cleanup enabled)
# EXECUTIONS_DATA_MAX_AGE=336 (14 days in hours)
# EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000 (maximum executions to keep)
# EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=15 (minutes between hard deletes)
# EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=60 (minutes between soft deletes)

# =============================================================================
# Worker Configuration (configured in docker-compose.yml)
# =============================================================================
# deploy.replicas=3 (3 worker instances for parallel execution)
# QUEUE_WORKER_LOCK_DURATION=60000 (worker lock duration in ms)
# QUEUE_HEALTH_CHECK_ACTIVE=true (worker health monitoring)

# =============================================================================
# Redis Configuration (configured via docker-compose.yml command)
# =============================================================================
# maxmemory=1gb (memory limit for Redis)
# maxmemory-policy=allkeys-lru (LRU eviction when memory full)
# appendonly=yes (AOF persistence for durability)
# appendfsync=everysec (sync every second for balanced durability)

# =============================================================================
# AI Configuration
# =============================================================================
# Ollama host configuration (defaults to internal Docker service)
# OLLAMA_HOST=ollama:11434

# For external Ollama (running on host machine):
# OLLAMA_HOST=host.docker.internal:11434

# =============================================================================
# Memory Budget Summary (for 32 GB server)
# =============================================================================
# Service          | Limit  | Reservation | Instances | Total Reserved
# -----------------|--------|-------------|-----------|----------------
# PostgreSQL       | 12 GB  | 10 GB       | 1         | 10 GB
# Redis            | 1.5 GB | 1 GB        | 1         | 1 GB
# n8n Main         | 4 GB   | 2 GB        | 1         | 2 GB
# n8n Workers      | 2 GB   | 1 GB        | 3         | 3 GB
# Caddy            | -      | -           | 1         | ~256 MB
# Qdrant           | -      | -           | 1         | ~512 MB
# Ollama (if used) | -      | -           | 1         | ~2-8 GB
# Total Reserved   |        |             |           | ~17-23 GB
# Headroom for OS  |        |             |           | ~9-15 GB

# =============================================================================
# Task Runner Authentication
# =============================================================================
# Shared secret for task runner communication (generate a secure random token)
# Must be the same for n8n and task runner services
N8N_RUNNERS_AUTH_TOKEN=change_me

# =============================================================================
# Python Code Node Configuration (n8n v2)
# =============================================================================
# n8n v2 uses native Python via task runners for Code nodes
# Requires: N8N_RUNNERS_ENABLED=true, N8N_RUNNERS_MODE=external, and task runner service
#
# Native Python runner (required for Python Code nodes in v2):
# N8N_NATIVE_PYTHON_RUNNER=true (configured in docker-compose.yml)
#
# Package Management:
# - N8N_RUNNERS_STDLIB_ALLOW=* allows all standard library modules
# - N8N_RUNNERS_EXTERNAL_ALLOW=* enables dynamic package installation
# - Packages are installed on-demand when workflows execute
# - Common packages: numpy, pandas, requests, beautifulsoup4, etc.
#
# Security (v2 Defaults):
# - Environment variables are blocked from Code nodes by default
# - ExecuteCommand and LocalFileTrigger nodes disabled by default
# - Code executions run in isolated task runner containers

# =============================================================================
# Watchtower Integration (Production)
# =============================================================================
# If using Watchtower for automatic updates:
# 1. Ensure Watchtower monitors these labels:
#    - n8n (docker.n8n.io/n8nio/n8n:${N8N_VERSION})
#    - n8n-task-runner (n8nio/runners:${N8N_VERSION})
#    - n8n-worker (docker.n8n.io/n8nio/n8n:${N8N_VERSION})
#
# 2. CRITICAL: Task runner version MUST match n8n version
#    - Use Watchtower with --monitor-only for n8n services
#    - Coordinate updates via scripts/update.sh to ensure version sync
#
# 3. Recommended Watchtower configuration:
#    - Use --label-enable for selective monitoring
#    - Set WATCHTOWER_NOTIFICATION_URL for update alerts
#    - Consider --schedule for controlled update windows
#
# Example Watchtower command:
# docker run -d \
#   --name watchtower \
#   -v /var/run/docker.sock:/var/run/docker.sock \
#   containrrr/watchtower \
#   --label-enable \
#   --schedule "0 0 4 * * *" \
#   --cleanup
#
# Version Compatibility Check:
# After Watchtower updates, verify versions match:
# docker inspect n8n | grep Image
# docker inspect n8n-task-runner | grep Image
